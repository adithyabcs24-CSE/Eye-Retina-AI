{
  "type": "object",
  "required": [
    "id",
    "label",
    "task_type",
    "units",
    "pathways",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "classification",
        "regression"
      ]
    },
    "units": {
      "type": [
        "string",
        "null"
      ]
    },
    "pathways": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "direct",
          "indirect"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "LOADED",
        "STUB",
        "UNAVAILABLE"
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TargetCapability"
}